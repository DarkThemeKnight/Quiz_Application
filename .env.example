# Recall Studio configuration template.
# Copy to .env (`cp .env.example .env`) and fill in YOUR OWN values. Never commit .env.
# The app refuses to start while placeholder values (YOUR_ / REPLACE_) remain.

NODE_ENV=development
# Loopback only by default. A non-loopback host also requires ALLOW_PUBLIC_LISTEN=true (see docs/SECURITY.md).
APP_HOST=127.0.0.1
APP_PORT=4000
WEB_PORT=5173
# The browser origin you open. Dev (Vite): http://127.0.0.1:5173 · Production build: http://127.0.0.1:4000
APP_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info

# Generate locally: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_64_HEX_CHARS
# SESSION_TTL_DAYS=14
# COOKIE_SECURE=auto          # auto = secure cookies when APP_ORIGIN is https://

# Your local PostgreSQL database (URL-encode special characters in the password).
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DB_NAME
# DATABASE_SSL=disable        # disable | require | verify-full

# --- Development & tests only -------------------------------------------------------
# Separate databases that the automated tests WIPE. Never point these at your real data.
# TEST_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_TEST_DB
# E2E_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_E2E_DB

# Optional Docker Compose PostgreSQL (docker compose up -d) — used to build the URLs above.
# POSTGRES_USER=recall
# POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
# POSTGRES_DB=recall_studio
# POSTGRES_TEST_DB=recall_studio_test
# POSTGRES_PORT=5433
